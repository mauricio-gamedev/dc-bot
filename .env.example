# Kick Live Watch (desativado até configurar as credenciais oficiais)
KICK_LIVE_ENABLED=false
KICK_CHANNEL_SLUG=MiojoPlays
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_BROADCASTER_USER_ID=
KICK_LIVE_POLL_MS=90000

# Minecraft Bedrock Game Interactive
# Recomendado: configure uma chave persistente no Render para o relay Android não perder acesso em reinícios.
# Nunca publique essa chave.
MINECRAFT_BRIDGE_TOKEN=
# WSS direto é mantido apenas como fallback experimental.
MINECRAFT_BRIDGE_PUBLIC_URL=wss://dc-bot-us5v.onrender.com/minecraft
# Endpoint HTTPS usado pelo relay local Android.
MINECRAFT_RELAY_PUBLIC_URL=https://dc-bot-us5v.onrender.com
