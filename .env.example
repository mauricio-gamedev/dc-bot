DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ENABLE_MEMBER_EVENTS=false

# Mio visual overrides (opcionais; a arte oficial já vem no repositório)
MIO_CHARACTER_IMAGE_URL=
MIO_CHARACTER_BANNER_URL=
MIO_CHARACTER_PROFILE_URL=
MIO_BADGE_IMAGE_URL=
MIO_BADGE_ANIMATED_URL=

# Kick Live Watch
KICK_LIVE_ENABLED=false
KICK_CHANNEL_SLUG=MiojoPlays
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_BROADCASTER_USER_ID=
KICK_LIVE_POLL_MS=90000

# Kick Chat Interactive
# O mesmo app Kick acima é usado. Não coloque access/refresh tokens manualmente aqui.
KICK_INTERACTIVE_ENABLED=true
KICK_OAUTH_REDIRECT_URL=https://dc-bot-us5v.onrender.com/kick/oauth/callback
# "bot" tenta usar o BOT oficial do app; se a Kick rejeitar, o código faz fallback para "user".
KICK_CHAT_MESSAGE_TYPE=bot
# false evita flood; !comandos continua respondendo no chat.
KICK_INTERACTIVE_REPLY_ACTIONS=false
# Webhook configurado no painel Kick Developer:
# https://dc-bot-us5v.onrender.com/kick/webhook
# Scopes necessários no OAuth: chat:write events:subscribe

# Minecraft Bedrock Game Interactive
# Se MINECRAFT_BRIDGE_TOKEN ficar vazio, o bot gera uma chave aleatória nova a cada reinício.
MINECRAFT_BRIDGE_TOKEN=
MINECRAFT_BRIDGE_PUBLIC_URL=wss://dc-bot-us5v.onrender.com/minecraft
